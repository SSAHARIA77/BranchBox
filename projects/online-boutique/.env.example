# Deployment settings for BranchBox + Online Boutique.
# Copy to ".env" in this folder; docker compose reads it automatically.
# With no .env at all, everything is private to this machine (127.0.0.1).

# --- Local, single machine (default) ----------------------------------------
# BB_BIND_ADDRESS=127.0.0.1
# BB_EDGE_DOMAIN=localhost

# --- Shared server: teammates connect from their own laptops ---------------
# Listen on every network interface.
# BB_BIND_ADDRESS=0.0.0.0
#
# Public hostname of the server. Sandbox URLs become
# http://<sandbox-id>.<BB_EDGE_DOMAIN>:8080. nip.io is a free wildcard DNS
# service: "anything.20.193.10.5.nip.io" resolves to 20.193.10.5, so no DNS
# setup is needed. Use the server's public IP (cloud VM) or LAN IP (hotspot).
# BB_EDGE_DOMAIN=20.193.10.5.nip.io
#
# Required whenever BB_BIND_ADDRESS is not 127.0.0.1: the controller drives
# Docker on this host. Generate one with:
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#   Linux:      openssl rand -hex 16
# BB_API_TOKEN=change-me
#
# Build sandboxes from the team's GitHub repository instead of the local
# ../../../microservices-demo folder (public repositories need no credentials).
# BB_REPOSITORY_URL=https://github.com/<your-org>/microservices-demo.git

# Host port of the edge (the shop). Default 8080.
# BB_EDGE_PORT=8080

# Host port of the baseline frontend, bypassing the edge. Default 8081.
# BB_DIRECT_PORT=8081

# Exact public URL of the shop when it is reached through a proxy that hides
# the port, e.g. GitHub Codespaces (https://<name>-8080.app.github.dev) or a
# tunnel. The CLI then prints links based on it. Set automatically by
# scripts/codespace-setup.sh.
# BB_PUBLIC_URL=
